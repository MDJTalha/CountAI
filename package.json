{
  "name": "countai-by-aivon",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:engine": "node --test tests/engine.test.mjs",
    "test:detection-enhancement": "node --test tests/detectionEnhancement.test.mjs",
    "test:camera-health": "node --test tests/cameraHealth.test.mjs",
    "test:camera-health-history": "node --test tests/cameraHealthHistory.test.mjs",
    "server": "node server/index.mjs",
    "test:server": "node --test tests/server.test.mjs",
    "test:pwa-build": "node --test tests/pwaBuild.test.mjs",
    "test:operational-events": "node --test tests/operationalEvents.test.mjs",
    "test:spais-contracts": "node --test tests/spaisContracts.test.mjs",
    "test": "npm run test:engine && npm run test:analytics && npm run test:overlay-labels && npm run test:operational-events && npm run test:spais-contracts && npm run test:detection-enhancement && npm run test:camera-health && npm run test:camera-health-history && npm run build && npm run test:pwa-build && npm run test:server",
    "test:analytics": "node --test tests/sessionAnalytics.test.mjs",
    "test:overlay-labels": "node --test tests/detectionOverlay.test.mjs"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.21.1"
  }
}
