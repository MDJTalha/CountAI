# Copy to .env on the deployment host. Never commit the populated .env.
NODE_ENV=production
PORT=8787

# Configure an issuer and audience that exactly match your identity provider.
SPAIS_AUTH_ISSUER=https://identity.example.com/
SPAIS_AUTH_AUDIENCE=countai-api
SPAIS_AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# Alternative only when approved by security: use a secret manager to inject a
# random secret of at least 32 UTF-8 bytes. Do not store it in source control.
# SPAIS_AUTH_HS256_SECRET=

# Compose overrides these paths to persistent volumes.
SPAIS_EVENTS_DB_PATH=/var/lib/countai/events.sqlite
COUNTAI_BACKUP_DIR=/var/backups/countai
COUNTAI_LEARNING_MEDIA_DIR=/var/lib/countai/learning-media

# Choose a reviewed retention period (0 disables learning-source expiry).
COUNTAI_LEARNING_SOURCE_RETENTION_DAYS=90
COUNTAI_ENABLE_HSTS=false

COUNTAI_RATE_LIMIT_WINDOW_MS=60000
COUNTAI_API_RATE_LIMIT=120
COUNTAI_WRITE_RATE_LIMIT=30
COUNTAI_HEADERS_TIMEOUT_MS=15000
COUNTAI_REQUEST_TIMEOUT_MS=120000
COUNTAI_KEEPALIVE_TIMEOUT_MS=5000
